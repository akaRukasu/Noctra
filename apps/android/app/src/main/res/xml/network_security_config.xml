<?xml version="1.0" encoding="utf-8"?>
<!-- Serveurs Noctra en http sur le réseau local et certificats installés par
     l'utilisateur (serveur auto-hébergé) acceptés. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
