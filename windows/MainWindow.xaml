<Window x:Class="Noctra.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Noctra.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:integration="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        WindowStyle="None" Title="Noctra" Icon="Noctra.ico" Width="1320" Height="880" MinWidth="920" MinHeight="665" WindowStartupLocation="CenterScreen"
        Background="#07080D" Foreground="#F5F4FA" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        UseLayoutRounding="True" Loaded="Load" Closing="CloseWindow" PreviewKeyDown="WindowKey">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Noctra 0.6 : palette nuit, accent violet / cyan, surfaces discrètes. -->
        <FontFamily x:Key="DisplayFont">./fonts/#Noctra Display</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Ink" Color="#F5F4FA"/>
        <SolidColorBrush x:Key="Muted" Color="#A3A9BC"/>
        <SolidColorBrush x:Key="Accent" Color="#BCAAFF"/>
        <SolidColorBrush x:Key="Panel" Color="#13151F"/>
        <SolidColorBrush x:Key="Outline" Color="#262A39"/>
        <SolidColorBrush x:Key="Canvas" Color="#07080D"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#C7B3FF"/><GradientStop Color="#7FD8F2" Offset="1"/>
        </LinearGradientBrush>
        <CubicEase x:Key="Ease" EasingMode="EaseOut"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="Button" x:Key="Action">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Hover" CornerRadius="11" Background="{TemplateBinding Foreground}" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To=".12" Duration="0:0:0.14" EasingFunction="{StaticResource Ease}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource Ease}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Bouton principal blanc, comme les grandes plateformes : lisible sur tous les visuels. -->
        <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#F5F4FA"/>
            <Setter Property="Foreground" Value="#0A0A12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,8"/>
        </Style>
        <Style TargetType="Button" x:Key="DockIcon" BasedOn="{StaticResource Action}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="#1CFFFFFF"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="WindowCaption">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1FFFFFFF"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#33FFFFFF"/></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="Tag" Value="close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Cartes : le visuel s'agrandit au survol (code), anneau d'accent au clavier. -->
        <Style TargetType="Button" x:Key="Card">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter RecognizesAccessKey="True"/>
                            <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Margin="-4" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Onglets : texte discret, onglet actif en blanc avec un trait d'accent. -->
        <Style TargetType="Button" x:Key="NavigationTab">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="10" Background="#14FFFFFF" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Indicator" Height="3" Width="20" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                    Background="{StaticResource AccentGradient}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Round" BasedOn="{StaticResource Action}">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="#4A5066" Background="#14FFFFFF" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#0A0A12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#F5F4FA"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Margin="0,8" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource AccentGradient}"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="#FFFFFF"/>
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip" CornerRadius="3" Margin="2.5" Background="#3A3E52"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7C8199"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1C1F2B"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#30354A"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2A2840"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#24FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#181B26"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="PickerRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Picker" Background="#1A1D29" BorderBrush="#2E3346" BorderThickness="1" CornerRadius="11"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Picker" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Picker" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="14,8,36,8" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                RecognizesAccessKey="True"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" IsHitTestVisible="False" Foreground="{StaticResource Muted}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PickerRoot}"
                                   AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   VerticalOffset="5">
                                <Border Width="{Binding ActualWidth, ElementName=PickerRoot}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        TextElement.Foreground="{StaticResource Ink}" Background="#1A1D29" BorderBrush="#363B51" BorderThickness="1" CornerRadius="12" Padding="5">
                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161923"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#2B3042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#161923"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#2B3042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowFrame">
        <Grid.RowDefinitions><RowDefinition x:Name="CaptionRow" Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="FrameHeader" Background="{StaticResource Canvas}">
            <DockPanel Margin="16,0,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="N" Foreground="#0A0A12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Noctra" FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="#C9CCDA" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CaptionMinimize" Content="&#xE921;" Click="MinimizeWindow" Style="{StaticResource WindowCaption}" ToolTip="Réduire" AutomationProperties.Name="Réduire"/>
                    <Button x:Name="CaptionMaximize" Content="&#xE922;" Click="MaximizeWindow" Style="{StaticResource WindowCaption}" ToolTip="Agrandir ou restaurer" AutomationProperties.Name="Agrandir ou restaurer"/>
                    <Button x:Name="CaptionClose" Content="&#xE8BB;" Click="QuitWindow" Style="{StaticResource WindowCaption}" Tag="close" ToolTip="Fermer" AutomationProperties.Name="Fermer"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="LoginShell" Background="{StaticResource Canvas}">
            <!-- Halos lumineux discrets (identité Noctra : nuit violette et cyan). -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center=".18,.12" GradientOrigin=".18,.12" RadiusX=".7" RadiusY=".85">
                        <GradientStop Color="#3A2E7A"/><GradientStop Color="#00160F3A" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center=".92,.95" GradientOrigin=".92,.95" RadiusX=".55" RadiusY=".7">
                        <GradientStop Color="#55206E86"/><GradientStop Color="#00206E86" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1080" Margin="48,40" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,44">
                            <Border Background="{StaticResource AccentGradient}" Width="42" Height="42" CornerRadius="12">
                                <TextBlock Text="N" FontSize="24" FontWeight="Bold" Foreground="#0A0A12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Noctra" FontFamily="{StaticResource DisplayFont}" FontSize="24" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="FILMS · SÉRIES · TV EN DIRECT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,14"/>
                        <TextBlock Text="Tout votre cinéma, au même endroit." FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap" FontSize="50"
                                   LineHeight="58" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock Text="Reprenez vos films et séries là où vous les avez laissés, découvrez les nouveautés et zappez entre les directs."
                                   Margin="0,20,0,0" TextWrapping="Wrap" FontSize="17" LineHeight="26" LineStackingStrategy="BlockLineHeight"
                                   MaxWidth="440" HorizontalAlignment="Left" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="20" Background="#D9121420" BorderBrush="#2A2F42" BorderThickness="1" Padding="32,30">
                        <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="10" Opacity=".45" Color="#000000"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Connexion" FontFamily="{StaticResource DisplayFont}" FontSize="28"/>
                            <TextBlock Text="Avec votre compte Jellyfin." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,24"/>
                            <Label Content="Identifiant" Target="{Binding ElementName=Username}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Padding="0,0,0,7"/>
                            <TextBox x:Name="Username" AutomationProperties.Name="Identifiant" MinHeight="46"/>
                            <Label Content="Mot de passe" Target="{Binding ElementName=Password}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Padding="0,16,0,7"/>
                            <PasswordBox x:Name="Password" AutomationProperties.Name="Mot de passe" MinHeight="46"/>
                            <CheckBox x:Name="Remember" Content="Rester connecté sur ce PC" Margin="0,18,0,20"/>
                            <Button x:Name="SignInButton" Style="{StaticResource Primary}" Content="Se connecter" MinHeight="48" IsDefault="True" Click="SignIn"/>
                            <Expander x:Name="ServerSettings" Header="Adresse du serveur" Foreground="{StaticResource Muted}" Margin="0,16,0,0">
                                <TextBox x:Name="ServerAddress" AutomationProperties.Name="Adresse Noctra ou Jellyfin" Margin="0,8,0,0"/>
                            </Expander>
                            <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Foreground="#FFB3C7" AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="1" x:Name="LibraryShell" Visibility="Collapsed" Background="{StaticResource Canvas}">
            <!-- Fond d'ambiance : visuel du titre mis en avant, très estompé, fondu vers le bas. -->
            <Image x:Name="AmbientArt" Stretch="UniformToFill" Opacity=".16" IsHitTestVisible="False" VerticalAlignment="Top">
                <Image.Effect><BlurEffect Radius="40" KernelType="Gaussian"/></Image.Effect>
            </Image>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint=".5,0" EndPoint=".5,1">
                        <GradientStop Color="#9907080D"/><GradientStop Color="#F207080D" Offset=".55"/><GradientStop Color="#07080D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <DockPanel x:Name="ContentDock">
                <Border x:Name="TvSidebar" DockPanel.Dock="Left" Visibility="Collapsed" Width="196"
                        VerticalAlignment="Top" Margin="32,96,0,24" Padding="12"
                        Background="#E6111320" BorderBrush="#22283A" BorderThickness="1" CornerRadius="18">
                    <local:SmoothScrollViewer x:Name="TvMenuScroller" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sources TV">
                        <StackPanel x:Name="TvMenu"/>
                    </local:SmoothScrollViewer>
                </Border>
                <local:SmoothScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageContent" Margin="40,96,40,32"/>
                </local:SmoothScrollViewer>
            </DockPanel>
            <!-- Bandeau flottant : transparent sur les visuels, opaque dès que la page défile. -->
            <Border x:Name="NavigationBar" VerticalAlignment="Top" IsHitTestVisible="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint=".5,0" EndPoint=".5,1">
                        <GradientStop Color="#D907080D"/><GradientStop Color="#0007080D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Border x:Name="NavigationSolid" Background="#F007080D" Opacity="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"/>
                    <DockPanel x:Name="NavigationHeader" Height="66" Margin="28,12,28,12" LastChildFill="False">
                        <Border DockPanel.Dock="Left" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="NavigationBrand" Text="N" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource AccentGradient}"
                                           VerticalAlignment="Center" Width="36" TextAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="HomeTab" Tag="active" Style="{StaticResource NavigationTab}" Click="OpenHome"
                                        Content="Accueil" AutomationProperties.Name="Accueil"/>
                                <Button x:Name="LibraryTab" Style="{StaticResource NavigationTab}" Click="OpenLibraries"
                                        Content="Médiathèques" AutomationProperties.Name="Médiathèques"/>
                                <Button x:Name="DiscoverTab" Style="{StaticResource NavigationTab}" Click="OpenDiscover"
                                        Content="Découvrir" AutomationProperties.Name="Découverte"/>
                                <Button x:Name="TvTab" Style="{StaticResource NavigationTab}" Click="OpenTv"
                                        Content="TV" AutomationProperties.Name="TV en direct"/>
                                <Button x:Name="FavoritesTab" Style="{StaticResource NavigationTab}" Click="OpenFavorites"
                                        Visibility="Collapsed" Content="Ma liste" AutomationProperties.Name="Favoris"/>
                                <Button x:Name="MoreTab" Style="{StaticResource DockIcon}" Click="OpenMore" Width="44" MinHeight="44" Margin="4,0,0,0"
                                        Content="&#xE712;" ToolTip="Toutes les fonctions" AutomationProperties.Name="Toutes les fonctions"/>
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid x:Name="HeaderSearch" Width="240" Height="44">
                                <TextBox x:Name="SearchBox" FontSize="14" MinHeight="44" Padding="38,9,12,9" Background="#1AFFFFFF" BorderBrush="#24FFFFFF"
                                         AutomationProperties.Name="Rechercher un film ou une série" KeyDown="SearchKey"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Muted}"
                                           Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="Rechercher un titre" Margin="39,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="SearchButton" Style="{StaticResource DockIcon}" Content="&#xE721;" Click="Search"
                                    ToolTip="Rechercher" AutomationProperties.Name="Rechercher" Margin="4,0"/>
                            <Button x:Name="ProfileButton" Style="{StaticResource Action}" Click="OpenProfile" Height="44" Padding="6,0,14,0" ToolTip="Profil et réglages"
                                    Background="#14FFFFFF" AutomationProperties.Name="Profil et réglages">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ProfileAvatar" Background="{StaticResource AccentGradient}" Width="30" Height="30" CornerRadius="15">
                                        <TextBlock x:Name="Initial" Foreground="#0A0A12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="ProfileName" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="BackButton" Style="{StaticResource DockIcon}" Content="&#xE72B;" Click="Back"
                                    ToolTip="Retour" AutomationProperties.Name="Retour"/>
                            <TextBlock x:Name="PageLabel" Visibility="Collapsed" Margin="7,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       MaxWidth="155" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <!-- Notifications : pastille en bas, au-dessus du contenu. -->
            <Border x:Name="StatusBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,26" Padding="20,12"
                    Background="#F21C1F2C" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" MaxWidth="720" Visibility="Collapsed">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity=".5" Color="#000000"/></Border.Effect>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1" x:Name="Player" Visibility="Collapsed" Background="#000000">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="PlayerHeader" Background="#07080D" Padding="18,10">
                <DockPanel>
                    <Button x:Name="ReturnButton" DockPanel.Dock="Left" Content="&#xE72B;" Style="{StaticResource Round}" Click="StopPlayback"
                            Background="Transparent" ToolTip="Retour à Noctra" AutomationProperties.Name="Retour à Noctra"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Click="OpenCast" Margin="10,0,0,0" AutomationProperties.Name="Diffuser">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC15;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Diffuser" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border DockPanel.Dock="Right" CornerRadius="8" Background="#14FFFFFF" Padding="11,6" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaybackMode" Foreground="#C3C8D8" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="LECTURE EN COURS" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="MediaTitle" FontFamily="{StaticResource DisplayFont}" FontSize="17" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <integration:WindowsFormsHost Grid.Row="1" x:Name="VideoHost" Visibility="Collapsed"/>
            <StackPanel Grid.Row="1" x:Name="PlaybackNotice" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Margin="28">
                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <TextBlock Text="N" FontSize="30" Foreground="#0A0A12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="PlayerMessage" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" Foreground="#D6DAE6" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="OpeningProgress" IsIndeterminate="True" Height="3" Width="200" Foreground="{StaticResource AccentGradient}" Background="#1FFFFFFF" BorderThickness="0" Margin="0,22,0,0"/>
                <Button x:Name="InstallButton" Content="Installer le lecteur et lancer la vidéo" Style="{StaticResource Primary}"
                        Margin="0,18,0,0" HorizontalAlignment="Center" Click="InstallPlayer"/>
                <Button x:Name="RetryPlaybackButton" Content="Réessayer la lecture" Style="{StaticResource Primary}"
                        Margin="0,14,0,0" HorizontalAlignment="Center" Visibility="Collapsed" Click="RetryPlayback"/>
            </StackPanel>
            <!-- Commandes : sous la vidéo en fenêtre, flottantes (dégradé) en plein écran et en direct. -->
            <Border Grid.Row="2" x:Name="PlayerControls" Padding="28,8,28,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint=".5,0" EndPoint=".5,1">
                        <GradientStop Color="#C0050608"/><GradientStop Color="#F2050608" Offset=".45"/><GradientStop Color="#050608" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock x:Name="PlayerHint" Height="18" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <Slider x:Name="Timeline" IsEnabled="False" IsMoveToPointEnabled="True" AutomationProperties.Name="Position de lecture"
                            PreviewMouseLeftButtonDown="BeginSeek" PreviewMouseLeftButtonUp="EndSeek" KeyUp="SeekKey"/>
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="LiveQualityButton" Content="Qualité" Style="{StaticResource Action}" Click="ChooseLiveQuality" Visibility="Collapsed"
                                    AutomationProperties.Name="Qualités TV" ToolTip="Afficher toutes les qualités du flux" Margin="0,0,8,0" MinWidth="82"/>
                            <Button Content="&#xE8D6;" Style="{StaticResource Round}" Background="Transparent" Click="AudioTrack" ToolTip="Choisir une piste audio"
                                    AutomationProperties.Name="Pistes audio" Margin="0,0,4,0"/>
                            <Button Content="&#xE7F0;" Style="{StaticResource Round}" Background="Transparent" Click="SubtitleTrack" ToolTip="Choisir les sous-titres"
                                    AutomationProperties.Name="Sous-titres" Margin="0,0,4,0"/>
                            <Button x:Name="FullscreenReturn" Content="Retour" Style="{StaticResource Action}" Click="StopPlayback" Visibility="Collapsed" Margin="0,0,10,0"/>
                            <Button x:Name="FullscreenButton" Content="&#xE740;" Style="{StaticResource Round}" Background="Transparent" Click="Fullscreen" ToolTip="Plein écran · F11"
                                    AutomationProperties.Name="Plein écran"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackwardButton" Style="{StaticResource Round}" Background="Transparent" Click="BackFifteen" Width="52"
                                    ToolTip="Reculer de 15 secondes · ←" AutomationProperties.Name="Reculer de 15 secondes" Margin="0,0,4,0">
                                <TextBlock Text="−15" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="14"/>
                            </Button>
                            <Button x:Name="PauseButton" Content="&#xE769;" Style="{StaticResource Primary}" Click="TogglePause" Width="52" Height="52"
                                    Padding="0" FontFamily="{StaticResource IconFont}" FontSize="20" FontWeight="Normal" HorizontalContentAlignment="Center"
                                    AutomationProperties.Name="Pause" ToolTip="Pause · Espace" Margin="0,0,4,0"/>
                            <Button x:Name="ForwardButton" Style="{StaticResource Round}" Background="Transparent" Click="ForwardFifteen" Width="52"
                                    ToolTip="Avancer de 15 secondes · →" AutomationProperties.Name="Avancer de 15 secondes" Margin="0,0,18,0">
                                <TextBlock Text="+15" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="14"/>
                            </Button>
                            <TextBlock x:Name="PositionLabel" Foreground="#C3C8D8" VerticalAlignment="Center" FontSize="13" MinWidth="118"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <Button Content="&#xE767;" Style="{StaticResource Round}" Background="Transparent" Click="MutePlayer" ToolTip="Couper ou rétablir le son · M"
                                    AutomationProperties.Name="Couper ou rétablir le son" Margin="8,0,2,0"/>
                            <Slider x:Name="VolumeControl" Value="85" Minimum="0" Maximum="100" Width="96" VerticalAlignment="Center"
                                    AutomationProperties.Name="Volume" ValueChanged="ChangeVolume"/>
                            <Button x:Name="SkipCredits" Content="Passer le générique" Style="{StaticResource Primary}" Click="SkipCreditsClick"
                                    Visibility="Collapsed" Margin="18,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

