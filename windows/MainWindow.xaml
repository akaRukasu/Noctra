<Window x:Class="Noctra.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Noctra.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:integration="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        WindowStyle="None" Title="Noctra" Icon="Noctra.ico" Width="1320" Height="880" MinWidth="920" MinHeight="665" WindowStartupLocation="CenterScreen"
        Background="#07080D" Foreground="#F5F4FA" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        UseLayoutRounding="True" Loaded="Load" Closing="CloseWindow" PreviewKeyDown="WindowKey">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Noctra 0.6 : palette nuit, accent violet / cyan, surfaces discrètes. -->
        <FontFamily x:Key="DisplayFont">./fonts/#Noctra Display</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Ink" Color="#F5F4FA"/>
        <SolidColorBrush x:Key="Muted" Color="#A3A9BC"/>
        <SolidColorBrush x:Key="Accent" Color="#BCAAFF"/>
        <SolidColorBrush x:Key="Panel" Color="#13151F"/>
        <SolidColorBrush x:Key="Outline" Color="#262A39"/>
        <SolidColorBrush x:Key="Canvas" Color="#07080D"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#C7B3FF"/><GradientStop Color="#7FD8F2" Offset="1"/>
        </LinearGradientBrush>
        <CubicEase x:Key="Ease" EasingMode="EaseOut"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="Button" x:Key="Action">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Hover" CornerRadius="11" Background="{TemplateBinding Foreground}" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To=".12" Duration="0:0:0.14" EasingFunction="{StaticResource Ease}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource Ease}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Bouton principal blanc, comme les grandes plateformes : lisible sur tous les visuels. -->
        <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#F5F4FA"/>
            <Setter Property="Foreground" Value="#0A0A12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,8"/>
        </Style>
        <Style TargetType="Button" x:Key="DockIcon" BasedOn="{StaticResource Action}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="#1CFFFFFF"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="WindowCaption">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1FFFFFFF"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#33FFFFFF"/></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="Tag" Value="close"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Cartes : le visuel s'agrandit au survol (code), anneau d'accent au clavier. -->
        <Style TargetType="Button" x:Key="Card">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter RecognizesAccessKey="True"/>
                            <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Margin="-4" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Onglets : texte discret, onglet actif en blanc avec un trait d'accent. -->
        <Style TargetType="Button" x:Key="NavigationTab">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="10" Background="#14FFFFFF" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Indicator" Height="3" Width="20" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                    Background="{StaticResource AccentGradient}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Round" BasedOn="{StaticResource Action}">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- Dépliant (connexion : adresse du serveur) : chevron discret, sans le rond par défaut. -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="Header" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left" Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       VerticalAlignment="Center" Margin="0,0,9,0" RenderTransformOrigin=".5,.5">
                                                <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="#4A5066" Background="#14FFFFFF" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#0A0A12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#F5F4FA"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Margin="0,8" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource AccentGradient}"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="#FFFFFF"/>
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 0.8 : lecteur : boutons ronds translucides, bouton lecture blanc, pastilles, barre de progression. -->
        <Style TargetType="Button" x:Key="PlayerGlass">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Body" CornerRadius="999" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Hover" CornerRadius="999" Background="#FFFFFF" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="999" BorderThickness="1.5" BorderBrush="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".16"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value=".26"/>
                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".94" ScaleY=".94"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PlayerPlay" BasedOn="{StaticResource PlayerGlass}">
            <Setter Property="Width" Value="60"/><Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background" Value="#F5F4FA"/>
            <Setter Property="Foreground" Value="#0A0A12"/>
        </Style>
        <Style TargetType="Button" x:Key="PlayerPill" BasedOn="{StaticResource PlayerGlass}">
            <Setter Property="Width" Value="NaN"/><Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>
        <Style TargetType="Button" x:Key="PanelRow">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Body" CornerRadius="10" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Hover" CornerRadius="10" Background="#FFFFFF" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".08"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value=".14"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider" x:Key="PlayerTimeline">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="Played" Command="Slider.DecreaseLarge" Focusable="False" Height="5">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border CornerRadius="2.5" Background="{StaticResource AccentGradient}"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <!-- Curseur fin (2 px) : la partie lue s'arrête exactement à la position ; la pastille
                                         est dessinée autour, au survol. -->
                                    <Thumb x:Name="Knob" Width="2" Height="16" Opacity="0">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse Fill="#40C7B3FF" Margin="-11,-4"/>
                                                <Ellipse Fill="#FFFFFF" Margin="-7,0"/>
                                            </Grid>
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Height="5">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Played" Property="Opacity" Value=".5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Grip" CornerRadius="3" Margin="2.5" Background="#3A3E52"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7C8199"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1C1F2B"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#30354A"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Content" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2A2840"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#24FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#181B26"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="PickerRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Picker" Background="#1A1D29" BorderBrush="#2E3346" BorderThickness="1" CornerRadius="11"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Picker" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Picker" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="14,8,36,8" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                RecognizesAccessKey="True"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" IsHitTestVisible="False" Foreground="{StaticResource Muted}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PickerRoot}"
                                   AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   VerticalOffset="5">
                                <Border Width="{Binding ActualWidth, ElementName=PickerRoot}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        TextElement.Foreground="{StaticResource Ink}" Background="#1A1D29" BorderBrush="#363B51" BorderThickness="1" CornerRadius="12" Padding="5">
                                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161923"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#2B3042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#161923"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="#2B3042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 0.7 : menus sombres arrondis (menus contextuels, sous-menus, coches). -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <!-- Police de texte explicite : un menu hérite sinon de celle du bouton qui l'ouvre (icônes). -->
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F7171A25" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,0,12,12">
                            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity=".55" Color="#000000"/></Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Focusable="False">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="8,8,16,8"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Back" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <TextBlock x:Name="Check" DockPanel.Dock="Left" Width="24" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{StaticResource Accent}" Visibility="Hidden"/>
                                    <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               VerticalAlignment="Center" Margin="18,0,0,0" Visibility="Collapsed" Foreground="{StaticResource Muted}"/>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="6" VerticalOffset="-7" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#F7171A25" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,0,12,12">
                                    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity=".55" Color="#000000"/></Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Focusable="False">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Back" Property="Background" Value="#22FFFFFF"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator"><Border Height="1" Background="#24FFFFFF" Margin="10,5"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowFrame">
        <Grid.RowDefinitions><RowDefinition x:Name="CaptionRow" Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="FrameHeader" Background="{StaticResource Canvas}">
            <DockPanel Margin="16,0,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="N" Foreground="#0A0A12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Noctra" FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="#C9CCDA" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CaptionMinimize" Content="&#xE921;" Click="MinimizeWindow" Style="{StaticResource WindowCaption}" ToolTip="Réduire" AutomationProperties.Name="Réduire"/>
                    <Button x:Name="CaptionMaximize" Content="&#xE922;" Click="MaximizeWindow" Style="{StaticResource WindowCaption}" ToolTip="Agrandir ou restaurer" AutomationProperties.Name="Agrandir ou restaurer"/>
                    <Button x:Name="CaptionClose" Content="&#xE8BB;" Click="QuitWindow" Style="{StaticResource WindowCaption}" Tag="close" ToolTip="Fermer" AutomationProperties.Name="Fermer"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="LoginShell" Background="{StaticResource Canvas}">
            <!-- Halos lumineux discrets (identité Noctra : nuit violette et cyan). -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center=".18,.12" GradientOrigin=".18,.12" RadiusX=".7" RadiusY=".85">
                        <GradientStop Color="#3A2E7A"/><GradientStop Color="#00160F3A" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center=".92,.95" GradientOrigin=".92,.95" RadiusX=".55" RadiusY=".7">
                        <GradientStop Color="#55206E86"/><GradientStop Color="#00206E86" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1080" Margin="48,40" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,44">
                            <Border Background="{StaticResource AccentGradient}" Width="42" Height="42" CornerRadius="12">
                                <TextBlock Text="N" FontSize="24" FontWeight="Bold" Foreground="#0A0A12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Noctra" FontFamily="{StaticResource DisplayFont}" FontSize="24" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="FILMS · SÉRIES · TV EN DIRECT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,14"/>
                        <TextBlock Text="Tout votre cinéma, au même endroit." FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap" FontSize="50"
                                   LineHeight="58" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock Text="Reprenez vos films et séries là où vous les avez laissés, découvrez les nouveautés et zappez entre les directs."
                                   Margin="0,20,0,0" TextWrapping="Wrap" FontSize="17" LineHeight="26" LineStackingStrategy="BlockLineHeight"
                                   MaxWidth="440" HorizontalAlignment="Left" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="20" Background="#D9121420" BorderBrush="#2A2F42" BorderThickness="1" Padding="32,30">
                        <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="10" Opacity=".45" Color="#000000"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Connexion" FontFamily="{StaticResource DisplayFont}" FontSize="28"/>
                            <TextBlock Text="Avec votre compte Jellyfin." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,24"/>
                            <Label Content="Identifiant" Target="{Binding ElementName=Username}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Padding="0,0,0,7"/>
                            <TextBox x:Name="Username" AutomationProperties.Name="Identifiant" MinHeight="46"/>
                            <Label Content="Mot de passe" Target="{Binding ElementName=Password}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Padding="0,16,0,7"/>
                            <PasswordBox x:Name="Password" AutomationProperties.Name="Mot de passe" MinHeight="46"/>
                            <CheckBox x:Name="Remember" Content="Rester connecté sur ce PC" Margin="0,18,0,20"/>
                            <Button x:Name="SignInButton" Style="{StaticResource Primary}" Content="Se connecter" MinHeight="48" IsDefault="True" Click="SignIn"/>
                            <!-- 0.7 : connexion par code (Quick Connect), sans saisir le mot de passe sur ce PC. -->
                            <Button x:Name="QuickConnectButton" Style="{StaticResource Action}" MinHeight="44" Margin="0,10,0,0" Click="StartQuickConnect"
                                    AutomationProperties.Name="Se connecter avec un code">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Se connecter avec un code" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="QuickConnectPanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="18,14" CornerRadius="14" Background="#14BCAAFF" BorderBrush="#33BCAAFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CODE À AUTORISER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    <TextBlock x:Name="QuickConnectCode" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="Bold" Margin="0,6,0,4"
                                               AutomationProperties.AutomationId="QuickConnectCode"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12.5"
                                               Text="Sur un appareil déjà connecté (PWA, téléphone, Noctra Windows) : Profil › Quick Connect, puis saisissez ce code."/>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="ServerSettings" Header="Adresse du serveur" Foreground="{StaticResource Muted}" Margin="0,16,0,0">
                                <TextBox x:Name="ServerAddress" AutomationProperties.Name="Adresse Noctra ou Jellyfin" Margin="0,8,0,0"/>
                            </Expander>
                            <TextBlock x:Name="LoginStatus" TextWrapping="Wrap" Foreground="#FFB3C7" AutomationProperties.LiveSetting="Polite" Margin="0,10,0,0"/>
                            <Button x:Name="OfflineButton" Style="{StaticResource Action}" MinHeight="44" Margin="0,12,0,0" Click="OpenOffline" Visibility="Collapsed"
                                    Content="Lire mes téléchargements hors connexion"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="1" x:Name="LibraryShell" Visibility="Collapsed" Background="{StaticResource Canvas}">
            <!-- Fond d'ambiance : visuel du titre mis en avant, très estompé, fondu vers le bas. -->
            <!-- 0.8 : image déjà floutée (petite) étirée en douceur : aucun effet recalculé au défilement. -->
            <Image x:Name="AmbientArt" Stretch="UniformToFill" Opacity=".2" IsHitTestVisible="False" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="Linear" RenderOptions.CachingHint="Cache"/>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint=".5,0" EndPoint=".5,1">
                        <GradientStop Color="#9907080D"/><GradientStop Color="#F207080D" Offset=".55"/><GradientStop Color="#07080D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <DockPanel x:Name="ContentDock">
                <Border x:Name="TvSidebar" DockPanel.Dock="Left" Visibility="Collapsed" Width="196"
                        VerticalAlignment="Top" Margin="32,96,0,24" Padding="12"
                        Background="#E6111320" BorderBrush="#22283A" BorderThickness="1" CornerRadius="18">
                    <local:SmoothScrollViewer x:Name="TvMenuScroller" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sources TV">
                        <StackPanel x:Name="TvMenu"/>
                    </local:SmoothScrollViewer>
                </Border>
                <local:SmoothScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageContent" Margin="40,96,40,32"/>
                </local:SmoothScrollViewer>
            </DockPanel>
            <!-- Bandeau flottant : transparent sur les visuels, opaque dès que la page défile. -->
            <Border x:Name="NavigationBar" VerticalAlignment="Top" IsHitTestVisible="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint=".5,0" EndPoint=".5,1">
                        <GradientStop Color="#D907080D"/><GradientStop Color="#0007080D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Border x:Name="NavigationSolid" Background="#F007080D" Opacity="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1"/>
                    <DockPanel x:Name="NavigationHeader" Height="66" Margin="28,12,28,12" LastChildFill="False">
                        <Border DockPanel.Dock="Left" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="NavigationBrand" Text="N" FontFamily="{StaticResource DisplayFont}" FontSize="24" Foreground="{StaticResource AccentGradient}"
                                           VerticalAlignment="Center" Width="36" TextAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="HomeTab" Tag="active" Style="{StaticResource NavigationTab}" Click="OpenHome"
                                        Content="Accueil" AutomationProperties.Name="Accueil"/>
                                <Button x:Name="LibraryTab" Style="{StaticResource NavigationTab}" Click="OpenLibraries"
                                        Content="Médiathèques" AutomationProperties.Name="Médiathèques"/>
                                <Button x:Name="DiscoverTab" Style="{StaticResource NavigationTab}" Click="OpenDiscover"
                                        Content="Découvrir" AutomationProperties.Name="Découverte"/>
                                <Button x:Name="TvTab" Style="{StaticResource NavigationTab}" Click="OpenTv"
                                        Content="TV" AutomationProperties.Name="TV en direct"/>
                                <Button x:Name="FavoritesTab" Style="{StaticResource NavigationTab}" Click="OpenFavorites"
                                        Visibility="Collapsed" Content="Ma liste" AutomationProperties.Name="Favoris"/>
                                <Button x:Name="MoreTab" Style="{StaticResource DockIcon}" Click="OpenMore" Width="44" MinHeight="44" Margin="4,0,0,0"
                                        Content="&#xE712;" ToolTip="Toutes les fonctions" AutomationProperties.Name="Toutes les fonctions"/>
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid x:Name="HeaderSearch" Width="240" Height="44">
                                <TextBox x:Name="SearchBox" FontSize="14" MinHeight="44" Padding="38,9,12,9" Background="#1AFFFFFF" BorderBrush="#24FFFFFF"
                                         AutomationProperties.Name="Rechercher un film ou une série" KeyDown="SearchKey"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Muted}"
                                           Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="Rechercher un titre" Margin="39,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="SearchButton" Style="{StaticResource DockIcon}" Content="&#xE721;" Click="Search"
                                    ToolTip="Rechercher" AutomationProperties.Name="Rechercher" Margin="4,0"/>
                            <!-- 0.8 : SyncPlay discret, comme Jellyfin et la PWA : icône du bandeau, menu au clic, point d'accent en séance. -->
                            <Button x:Name="SyncHeaderButton" Style="{StaticResource DockIcon}" Click="HeaderSyncMenu" Margin="0,0,6,0"
                                    ToolTip="Regarder ensemble (SyncPlay)" AutomationProperties.Name="Séances SyncPlay">
                                <Grid>
                                    <TextBlock x:Name="SyncHeaderGlyph" Text="&#xE716;" FontFamily="{StaticResource IconFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="SyncHeaderDot" Width="8" Height="8" Fill="{StaticResource AccentGradient}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,-3,-5,0" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ProfileButton" Style="{StaticResource Action}" Click="OpenProfile" Height="44" Padding="6,0,14,0" ToolTip="Profil et réglages"
                                    Background="#14FFFFFF" AutomationProperties.Name="Profil et réglages">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ProfileAvatar" Background="{StaticResource AccentGradient}" Width="30" Height="30" CornerRadius="15">
                                        <TextBlock x:Name="Initial" Foreground="#0A0A12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="ProfileName" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button x:Name="BackButton" Style="{StaticResource DockIcon}" Content="&#xE72B;" Click="Back"
                                    ToolTip="Retour" AutomationProperties.Name="Retour"/>
                            <TextBlock x:Name="PageLabel" Visibility="Collapsed" Margin="7,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                       MaxWidth="155" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <!-- Notifications : pastille en bas, au-dessus du contenu. -->
            <Border x:Name="StatusBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,26" Padding="20,12"
                    Background="#F21C1F2C" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" MaxWidth="720" Visibility="Collapsed">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity=".5" Color="#000000"/></Border.Effect>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
        <!-- 0.8 : lecteur plein cadre. La vidéo occupe tout l'espace ; l'en-tête et les commandes
             flottent par-dessus (fenêtres superposées) et s'effacent seuls pendant la lecture. -->
        <Grid Grid.Row="1" x:Name="Player" Visibility="Collapsed" Background="#000000" ClipToBounds="True">
            <integration:WindowsFormsHost x:Name="VideoHost" Visibility="Collapsed"/>
            <!-- Écoute musicale : pochette en grand sur son propre reflet flouté. -->
            <Grid x:Name="AudioStage" Visibility="Collapsed" ClipToBounds="True" Background="#07080D">
                <Image x:Name="AudioBackdrop" Stretch="UniformToFill" Opacity=".55" RenderOptions.BitmapScalingMode="Linear"/>
                <Border>
                    <Border.Background>
                        <RadialGradientBrush RadiusX=".9" RadiusY=".9"><GradientStop Color="#5507080D" Offset="0"/><GradientStop Color="#F207080D" Offset="1"/></RadialGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,96,40,170">
                    <Border Width="300" Height="300" CornerRadius="22" Background="#1C1F2C" HorizontalAlignment="Center" ClipToBounds="True">
                        <Border.Effect><DropShadowEffect BlurRadius="60" ShadowDepth="16" Opacity=".7" Color="#000000"/></Border.Effect>
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="80" Foreground="#3A3F55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="AudioCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip><RectangleGeometry Rect="0,0,300,300" RadiusX="22" RadiusY="22"/></Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="AudioTitle" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,30,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="640" AutomationProperties.AutomationId="AudioTitle"/>
                    <TextBlock x:Name="AudioArtist" FontSize="17" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="AudioAlbum" FontSize="14" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <!-- Paroles synchronisées (Jellyfin 10.9+) : ligne en cours mise en avant. -->
                    <StackPanel x:Name="LyricsPanel" Margin="0,28,0,0" Visibility="Collapsed" MaxWidth="760">
                        <TextBlock x:Name="LyricPrevious" FontSize="15" Foreground="#66FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LyricCurrent" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,10" AutomationProperties.AutomationId="LyricCurrent"/>
                        <TextBlock x:Name="LyricNext" FontSize="15" Foreground="#66FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="PlaybackNotice" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Margin="28">
                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <TextBlock Text="N" FontSize="30" Foreground="#0A0A12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="PlayerMessage" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" Foreground="#D6DAE6" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="OpeningProgress" IsIndeterminate="True" Height="3" Width="200" Foreground="{StaticResource AccentGradient}" Background="#1FFFFFFF" BorderThickness="0" Margin="0,22,0,0"/>
                <Button x:Name="InstallButton" Content="Installer le lecteur et lancer la vidéo" Style="{StaticResource Primary}"
                        Margin="0,18,0,0" HorizontalAlignment="Center" Click="InstallPlayer"/>
                <Button x:Name="RetryPlaybackButton" Content="Réessayer la lecture" Style="{StaticResource Primary}"
                        Margin="0,14,0,0" HorizontalAlignment="Center" Visibility="Collapsed" Click="RetryPlayback"/>
            </StackPanel>
            <!-- En-tête : retour, titre, regarder ensemble, mode de lecture, diffusion. -->
            <Border x:Name="PlayerHeader" VerticalAlignment="Top" Padding="22,16,22,44">
                <Border.Background>
                    <LinearGradientBrush StartPoint=".5,0" EndPoint=".5,1">
                        <GradientStop Color="#E6000000"/><GradientStop Color="#80000000" Offset=".55"/><GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button x:Name="ReturnButton" DockPanel.Dock="Left" Content="&#xE72B;" Style="{StaticResource PlayerGlass}" Click="StopPlayback"
                            Background="#1FFFFFFF" ToolTip="Retour à Noctra · Échap" AutomationProperties.Name="Retour à Noctra"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SyncBadge" CornerRadius="15" Padding="12,6" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"
                                Background="{StaticResource AccentGradient}">
                            <TextBlock x:Name="SyncBadgeText" Foreground="#0A0A12" FontSize="12" FontWeight="Bold" AutomationProperties.AutomationId="SyncBadgeText"/>
                        </Border>
                        <Button x:Name="SyncButton" Content="&#xE716;" Style="{StaticResource PlayerGlass}" Click="SyncMenu"
                                Margin="0,0,8,0" ToolTip="Regarder ensemble (SyncPlay)" AutomationProperties.Name="Regarder ensemble"/>
                        <Border CornerRadius="15" Background="#26FFFFFF" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#FF5468" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="PlaybackMode" Foreground="#E6E8F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="&#xEC15;" Style="{StaticResource PlayerGlass}" Click="OpenCast" Margin="8,0,0,0"
                                ToolTip="Diffuser sur un autre écran" AutomationProperties.Name="Diffuser"/>
                    </StackPanel>
                    <StackPanel Margin="16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MediaEyebrow" Text="LECTURE EN COURS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="MediaTitle" FontFamily="{StaticResource DisplayFont}" FontSize="22" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock x:Name="MediaSubtitle" FontSize="13" Foreground="#C3C8D8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- Commandes : barre de progression (mémoire tampon, chapitres) et boutons. -->
            <Border x:Name="PlayerControls" VerticalAlignment="Bottom" Padding="28,56,28,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint=".5,0" EndPoint=".5,1">
                        <GradientStop Color="#00000000"/><GradientStop Color="#99000000" Offset=".4"/><GradientStop Color="#F0000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock x:Name="PlayerHint" Height="18" FontSize="12" Foreground="#C3C8D8" Margin="2,0,0,4"/>
                    <Grid x:Name="TimelineArea">
                        <Border x:Name="TimelineRail" Height="5" CornerRadius="2.5" Background="#33FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Border x:Name="BufferBar" Height="5" CornerRadius="2.5" Background="#59FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Width="0" IsHitTestVisible="False"/>
                        <Slider x:Name="Timeline" Style="{StaticResource PlayerTimeline}" IsEnabled="False" IsMoveToPointEnabled="True" AutomationProperties.Name="Position de lecture"
                                PreviewMouseLeftButtonDown="BeginSeek" PreviewMouseLeftButtonUp="EndSeek" KeyUp="SeekKey"/>
                        <Canvas x:Name="ChapterMarks" IsHitTestVisible="False"/>
                    </Grid>
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="LiveServerButton" Style="{StaticResource PlayerPill}" Click="NextLiveServer" Visibility="Collapsed" Margin="0,0,8,0"
                                    AutomationProperties.Name="Serveur suivant" ToolTip="Passer au serveur suivant (image figée, coupures)"/>
                            <Button x:Name="LiveQualityButton" Content="Qualité" Style="{StaticResource PlayerPill}" Click="ChooseLiveQuality" Visibility="Collapsed"
                                    AutomationProperties.Name="Qualités TV" ToolTip="Afficher toutes les qualités du flux" Margin="0,0,8,0" MinWidth="76"/>
                            <Button x:Name="SubtitleButton" Content="&#xED1E;" Style="{StaticResource PlayerGlass}" Click="SubtitleTrack" ToolTip="Audio et sous-titres · C"
                                    AutomationProperties.Name="Audio et sous-titres" Margin="0,0,4,0"/>
                            <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource PlayerGlass}" Click="PlayerSettings"
                                    ToolTip="Vitesse, format d’image, décalages, chapitres, statistiques" AutomationProperties.Name="Réglages de lecture" Margin="0,0,4,0"/>
                            <Button x:Name="MiniButton" Content="&#xE8A7;" Style="{StaticResource PlayerGlass}" Click="ToggleMiniPlayer"
                                    ToolTip="Mini-lecteur au premier plan · P" AutomationProperties.Name="Mini-lecteur" Margin="0,0,4,0"/>
                            <Button x:Name="FullscreenReturn" Content="Retour" Style="{StaticResource PlayerPill}" Click="StopPlayback" Visibility="Collapsed" Margin="0,0,8,0"/>
                            <Button x:Name="FullscreenButton" Content="&#xE740;" Style="{StaticResource PlayerGlass}" Click="Fullscreen" ToolTip="Plein écran · F ou F11"
                                    AutomationProperties.Name="Plein écran"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="QueuePrevious" Content="&#xE892;" Style="{StaticResource PlayerGlass}" Click="QueuePreviousClick"
                                    Visibility="Collapsed" ToolTip="Titre précédent" AutomationProperties.Name="Titre précédent" Margin="0,0,4,0"/>
                            <Button x:Name="BackwardButton" Style="{StaticResource PlayerGlass}" Click="BackFifteen" Width="48" Height="48"
                                    ToolTip="Reculer de 15 secondes · ←" AutomationProperties.Name="Reculer de 15 secondes" Margin="0,0,6,0">
                                <Grid>
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
                                        <TextBlock.RenderTransform><ScaleTransform ScaleX="-1"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Text="15" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                </Grid>
                            </Button>
                            <Button x:Name="PauseButton" Content="&#xE769;" Style="{StaticResource PlayerPlay}" Click="TogglePause"
                                    AutomationProperties.Name="Pause" ToolTip="Pause · Espace" Margin="0,0,6,0"/>
                            <Button x:Name="ForwardButton" Style="{StaticResource PlayerGlass}" Click="ForwardFifteen" Width="48" Height="48"
                                    ToolTip="Avancer de 15 secondes · →" AutomationProperties.Name="Avancer de 15 secondes" Margin="0,0,4,0">
                                <Grid>
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="15" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                </Grid>
                            </Button>
                            <Button x:Name="QueueNext" Content="&#xE893;" Style="{StaticResource PlayerGlass}" Click="QueueNextClick"
                                    Visibility="Collapsed" ToolTip="Titre suivant · N" AutomationProperties.Name="Titre suivant" Margin="0,0,4,0"/>
                            <Border Width="14"/>
                            <Button x:Name="MuteButton" Content="&#xE767;" Style="{StaticResource PlayerGlass}" Click="MutePlayer" ToolTip="Couper ou rétablir le son · M"
                                    AutomationProperties.Name="Couper ou rétablir le son" Margin="0,0,2,0"/>
                            <Slider x:Name="VolumeControl" Value="85" Minimum="0" Maximum="100" Width="92" VerticalAlignment="Center"
                                    AutomationProperties.Name="Volume" ValueChanged="ChangeVolume"/>
                            <TextBlock x:Name="PositionLabel" Foreground="#E6E8F0" VerticalAlignment="Center" FontSize="13.5" Margin="18,0,0,0"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="EndsAtLabel" Foreground="#A3A9BC" VerticalAlignment="Center" FontSize="13" Margin="12,0,0,0"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <!-- Passer le générique : visible pendant le générique, même quand les commandes sont masquées. -->
            <Border x:Name="SkipCreditsHost" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,32,150" Padding="0">
                <Button x:Name="SkipCredits" Style="{StaticResource Primary}" Click="SkipCreditsClick" Visibility="Collapsed" MinHeight="48"
                        AutomationProperties.Name="Passer le générique" ToolTip="Passer le générique · S">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#0A0A12"/>
                        <TextBlock Text="Passer le générique" VerticalAlignment="Center" Foreground="#0A0A12"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Grid>
</Window>

