<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>Noctra</AssemblyName>
    <RootNamespace>Noctra.Windows</RootNamespace>
    <Version>0.7.0</Version>
    <ApplicationIcon>Noctra.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns process DPI awareness. WinForms is used only for the mpv surface. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Noctra.ico" />
    <Resource Include="fonts/NoctraDisplay-SemiBold.ttf" />
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Noctra.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>
</Project>

